# Copy this file to .env for local development:
#   cp .env.example .env
# In production, set these as real environment variables on your host instead
# of shipping a .env file (Render/Railway/Fly.io all have an "Environment"
# tab in their dashboard for this).

# Required. A long random string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on. Most hosting platforms inject this automatically.
PORT=3000

# Where the SQLite database file lives. Defaults to server/data.db if unset.
# In production, point this at a persistent disk/volume path (see server/README.md).
DB_PATH=

# Comma-separated list of origins allowed to call the API/WebSocket from a
# browser, e.g. https://your-app.example.com. Leave unset while the frontend
# is served by this same server (the default) -- same-origin requests don't
# need CORS at all. Only set this if you split the frontend onto a different
# domain/host than this API.
ALLOWED_ORIGIN=
