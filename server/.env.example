# Copy this file to .env for local development:
#   cp .env.example .env
# In production, set these as real environment variables on your host instead
# of shipping a .env file (Render/Railway/Fly.io all have an "Environment"
# tab in their dashboard for this).

# Required. A long random string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on. Most hosting platforms inject this automatically.
PORT=3000

# Required. A Postgres connection string (get a free one from https://neon.tech).
# ALL user data lives here -- accounts, friends, rooms, chat, notifications,
# leaderboard. There is no local-disk fallback: the server refuses to start
# without this, specifically so data can never silently end up on a disk that
# gets wiped on the next deploy. See CLAUDE.md, Rule #1.
DATABASE_URL=

# Comma-separated list of origins allowed to call the API/WebSocket from a
# browser, e.g. https://your-app.example.com. Leave unset while the frontend
# is served by this same server (the default) -- same-origin requests don't
# need CORS at all. Only set this if you split the frontend onto a different
# domain/host than this API.
ALLOWED_ORIGIN=

# The NUMBER of reverse proxies in front of this server (1 = Render alone,
# 2 = e.g. Cloudflare in front of Render). Set it only when that is really
# the case: a wrong value lets a client fake their IP via X-Forwarded-For
# (too high) or makes every visitor share one IP and one rate limit (unset
# while behind a proxy). Leave unset for local development.
TRUST_PROXY=

# Set to "1" to verify the Postgres server's TLS certificate (recommended once
# you have confirmed it works with your provider; stops a network attacker
# impersonating the database). Default: encrypted but not verified.
DATABASE_SSL_VERIFY=

# This server's own public URL, with no trailing slash (e.g.
# https://your-app.example.com). Used only to build the OAuth redirect_uri
# (must exactly match what you register with Google/Microsoft). Defaults to
# http://localhost:<PORT> when unset, which is fine for local development.
BASE_URL=

# --- Cloudflare Turnstile (CAPTCHA on signup, login after 2 failed attempts,
#     and forgot-password) ---
# Get both from https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both unset for local dev: falls back to Cloudflare's official test
# keys (site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA),
# which render a real widget and exercise the real verify call, but always
# pass -- so they give NO actual bot protection.
# In production, set both real keys or the CAPTCHA is a no-op that always passes.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend (password-reset and forgot-username emails) ---
# Get an API key from https://resend.com/api-keys. EMAIL_FROM must be an
# address on a domain verified in your Resend account, e.g.
# "Pomodoro <noreply@your-domain.com>".
# Leave RESEND_API_KEY unset for local dev: emails are logged to the server
# console instead of sent, so the whole forgot-password/forgot-username flow
# is fully testable without a Resend account.
# In production, set both or those emails only ever reach the server logs,
# never the user.
RESEND_API_KEY=
EMAIL_FROM=

# --- "Continue with Google" ---
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
# <BASE_URL>/api/auth/google/callback as an authorized redirect URI.
# Leave both unset to hide the Google sign-in button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- "Continue with Microsoft" ---
# Register an app at https://entra.microsoft.com (App registrations) and add
# <BASE_URL>/api/auth/microsoft/callback as a Web platform redirect URI.
# MICROSOFT_TENANT controls who can sign in: "common" (personal + work/school
# accounts, the default if unset), "consumers", "organizations", or a
# specific tenant ID/domain. Leave client id/secret unset to hide the button.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=

# --- "Continue with Facebook" ---
# Create an app at https://developers.facebook.com/apps (Facebook Login
# product) and add <BASE_URL>/api/auth/facebook/callback as a valid OAuth
# redirect URI. Leave both unset to hide the Facebook sign-in button.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Voice chat in Study Lounge rooms (WebRTC) ---
# Audio is peer-to-peer and uses free public STUN servers by default, which works for most
# home/office networks. Users behind strict NATs / some mobile carriers need a TURN relay.
# Set all three to enable one (e.g. a free Metered.ca / Cloudflare Calls TURN account, or your own
# coturn). TURN_URLS is comma separated, e.g. "turn:turn.example.com:3478,turns:turn.example.com:5349".
# Leave unset to use STUN only.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
