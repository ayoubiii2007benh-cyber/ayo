# Copy this file to .env for local development:
#   cp .env.example .env
# In production, set these as real environment variables on your host instead
# of shipping a .env file (Render/Railway/Fly.io all have an "Environment"
# tab in their dashboard for this).

# Required. A long random string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on. Most hosting platforms inject this automatically.
PORT=3000

# Where the SQLite database file lives. Defaults to server/data.db if unset.
# In production, point this at a persistent disk/volume path (see server/README.md).
DB_PATH=

# Comma-separated list of origins allowed to call the API/WebSocket from a
# browser, e.g. https://your-app.example.com. Leave unset while the frontend
# is served by this same server (the default) -- same-origin requests don't
# need CORS at all. Only set this if you split the frontend onto a different
# domain/host than this API.
ALLOWED_ORIGIN=

# Set to "1" only when this server actually runs behind a real reverse
# proxy (Render, or any host that terminates TLS/routes traffic to you).
# Enabling it without one lets a client fake their IP via X-Forwarded-For
# and bypass every rate limit below. Leave unset for local development.
TRUST_PROXY=

# This server's own public URL, with no trailing slash (e.g.
# https://your-app.example.com). Used only to build the OAuth redirect_uri
# (must exactly match what you register with Google/Microsoft). Defaults to
# http://localhost:<PORT> when unset, which is fine for local development.
BASE_URL=

# --- Cloudflare Turnstile (CAPTCHA on signup/login) ---
# Get both from https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both unset for local dev: signup/login simply skip verification.
# In production, set both or signup/login have no bot protection at all.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- "Continue with Google" ---
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
# <BASE_URL>/api/auth/google/callback as an authorized redirect URI.
# Leave both unset to hide the Google sign-in button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- "Continue with Microsoft" ---
# Register an app at https://entra.microsoft.com (App registrations) and add
# <BASE_URL>/api/auth/microsoft/callback as a Web platform redirect URI.
# MICROSOFT_TENANT controls who can sign in: "common" (personal + work/school
# accounts, the default if unset), "consumers", "organizations", or a
# specific tenant ID/domain. Leave client id/secret unset to hide the button.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
